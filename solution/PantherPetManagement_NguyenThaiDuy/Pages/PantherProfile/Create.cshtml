@page
@model PantherPetManagement_NguyenThaiDuy.Pages.PantherProfile.CreateModel
@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>PantherProfile</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="form-group">
                <label asp-for="Input.PantherTypeId" class="control-label"></label>
                <select asp-for="Input.PantherTypeId" class ="form-control" asp-items="Model.PantherTypes"></select>
                <span asp-validation-for="Input.PantherTypeId" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.PantherName" class="control-label"></label>
                <input asp-for="Input.PantherName" class="form-control" />
                <span asp-validation-for="Input.PantherName" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Weight" class="control-label"></label>
                <input asp-for="Input.Weight" class="form-control" />
                <span asp-validation-for="Input.Weight" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Characteristics" class="control-label"></label>
                <input asp-for="Input.Characteristics" class="form-control" />
                <span asp-validation-for="Input.Characteristics" class="text-warning"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Warning" class="control-label"></label>
                <input asp-for="Input.Warning" class="form-control" />
                <span asp-validation-for="Input.Warning" class="text-warning"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

