@page
@model PantherPetManagement_NguyenThaiDuy.Pages.PantherProfile.SearchModel
@{
}
h2>Search Pantehr Profiles</h2>

<form method="post">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                <label asp-for="Weight" class="form-label"></label>
                <input asp-for="Weight" class="form-control" type="number" step="0.1" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="PantherTypeName" class="form-label">Panther Type Name</label>
                <input asp-for="PantherTypeName" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</form>

@if (Model.HasSearched)
{
    <hr />
    <h4>Search Results (@Model.PantherProfiles.Count results found)</h4>

    @if (Model.PantherProfiles.Any())
    {
        <table class="table table-striped table-bordered border-1">
            <thead>
                <tr>
                    <th>Panther Name</th>
                    <th>Weight</th>
                    <th>Panther Type</th>
                    <th>Modified Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var profile in Model.PantherProfiles)
                {
                    <tr>
                        <td>@profile.PantherName</td>
                        <td>@profile.Weight</td>
                        <td>@profile.PantherType?.PantherTypeName</td>
                        <td>@profile.ModifiedDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-page="Detail" asp-route-id="@profile.PantherProfileId" class="btn btn-sm btn-info">Detail</a>
                            @if (Model.IsManager)
                            {
                                <a asp-page="Update" asp-route-id="@profile.PantherProfileId" class="btn btn-sm btn-warning">Update</a>
                                <a asp-page="Delete" asp-route-id="@profile.PantherProfileId" class="btn btn-sm btn-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No lion profiles found matching your search criteria.</p>
    }
}
